###############################################################################
#  GLENTREE SERENITY — WHATSAPP AI SALES AGENT
#  Environment template.
#
#  Copy this file to `.env.local` and fill in the values. `.env.local` is
#  gitignored; this file is safe to commit. Never put real keys in here.
#
#  Nothing below is filled in for you — every value marked <...> is a
#  placeholder you replace.
###############################################################################


# =============================================================================
# 1. AI PROVIDER  —  the AI brain
# =============================================================================
# Which one actually answers customers right now.
#   groq      = free tier, good for testing. Rate-limited, weaker tool use.
#   anthropic = production quality, paid. Switch to this before going live.
LLM_PROVIDER=groq

# --- Groq (free, test only) --------------------------------------------------
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>

# Groq's catalog changes often — check what's live: console.groq.com/docs/models
# openai/gpt-oss-120b is OpenAI's tool-calling-tuned open model, good fit here.
GROQ_MODEL=openai/gpt-oss-120b

# --- Anthropic (paid, production) --------------------------------------------
# Only read when LLM_PROVIDER=anthropic.
# Get a key: https://console.anthropic.com → Settings → API Keys
# Starts with "sk-ant-api03-..."
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Model the sales agent runs on. Leave as-is unless you have a reason.
ANTHROPIC_MODEL=claude-opus-4-8

# How hard the agent thinks per reply. Trade-off: quality vs speed vs cost.
#   low     = fastest, cheapest. Good for simple FAQ traffic.
#   medium  = recommended default for WhatsApp sales chat.
#   high    = deepest reasoning, slower replies.
AGENT_EFFORT=medium


# =============================================================================
# 2. SUPABASE  —  the CRM / lead database
# =============================================================================
# Where to get it: https://supabase.com/dashboard
#   → pick your project → Project Settings → API
#
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-project-url>

# "anon / public" key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# "service_role" key. SERVER ONLY — full database access, bypasses RLS.
# Never prefix this with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>


# =============================================================================
# 3. WHATSAPP CLOUD API  —  the messaging channel
# =============================================================================
# Where to get it: https://developers.facebook.com
#   → your App → WhatsApp → API Setup
#
# Phone Number ID of the WhatsApp business number (a long numeric string).
WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>

# WhatsApp Business Account ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=<your-waba-id>

# Permanent access token (System User token — the temporary 24h one will
# expire on you). Business Settings → System Users → Generate New Token.
WHATSAPP_ACCESS_TOKEN=<your-permanent-access-token>

# A password you invent yourself. You type the SAME string into the Meta
# dashboard when configuring the webhook. Meta echoes it back to prove the
# callback URL is really yours.
WHATSAPP_VERIFY_TOKEN=<invent-any-random-string>

# App Secret — used to verify the HMAC signature on every incoming webhook so
# nobody can POST fake customer messages at you.
# App → Settings → Basic → App Secret → Show.
WHATSAPP_APP_SECRET=<your-app-secret>

# Graph API version. Bump only when Meta deprecates the current one.
WHATSAPP_API_VERSION=v21.0

# ---- Instagram DMs (optional) ----
# The same AI agent answers Instagram Direct messages. Needs an Instagram
# professional account linked to a Facebook Page in the SAME Meta app as
# WhatsApp. Webhook: point Meta -> Instagram -> messages at /api/instagram.
# The numeric id of the Instagram professional account:
INSTAGRAM_ACCOUNT_ID=<your-instagram-account-id>
# Leave the three below EMPTY to reuse the WhatsApp token / verify token /
# app secret (usual case: one Meta app for both channels).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=


# =============================================================================
# 4. SALES TEAM  —  where hot leads get routed
# =============================================================================
# WhatsApp number that receives HOT LEAD handoff alerts.
# Full international format, digits only, no "+" and no spaces.
# Example for India: 919876543210
SALES_TEAM_WHATSAPP=<sales-rep-number-digits-only>

# Name the agent uses when telling a customer who will call them.
SALES_TEAM_NAME=Glentree Serenity Sales Team


# =============================================================================
# 5. APP
# =============================================================================
# Public base URL of this app. Used to build media links for brochures.
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password for the /admin dashboard. Invent one.
DASHBOARD_PASSWORD=<invent-a-dashboard-password>

# Protects the scheduled dispatchers (/api/cron/follow-ups and
# /api/cron/outbound — broadcasts, drip sequences) so only your scheduler can
# trigger them. Point a cron at each every 5 minutes with header:
#   Authorization: Bearer $CRON_SECRET You invent this — generate a strong one with:
#   openssl rand -hex 32
# If left blank, the cron route refuses to run at all (fails safe).
CRON_SECRET=


# =============================================================================
# 6. MARKETING CONTENT GENERATION  —  optional
# =============================================================================
# Powers /marketing — generates ad/social copy from real project data.
# Without a key, it still works using a built-in template (weaker copy).
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# =============================================================================
# 7. OPTIONAL  —  leave blank until you need them
# =============================================================================
# Google Maps link shown when a customer asks for the site location.
PROJECT_MAPS_URL=

# Public URL of the current approved brochure PDF.
BROCHURE_URL=
